{
  "_instructions": "Copy to appsettings.Development.json. Chat SignalR uses in-memory backplane when RedisBackplane:Enabled is false (no local Redis). Enable true when Redis runs for scaled hub messaging.",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    }
  },
  "Identity": {
    "PermissionCache": {
      "Provider": "InMemory",
      "ExpirationMinutes": 15,
      "RedisInstanceName": "UniHub:Identity"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=unihub_db;Username=postgres;Password=YOUR_PASSWORD",
    "MongoDB": "mongodb://localhost:27017",
    "Redis": "localhost:6379"
  },
  "RedisBackplane": {
    "ConnectionString": "localhost:6379",
    "Enabled": false
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "unihub_db_dev",
    "ConnectionTimeoutSeconds": 30,
    "ServerSelectionTimeoutSeconds": 30,
    "MaxConnectionPoolSize": 100,
    "MinConnectionPoolSize": 0
  },
  "Jwt": {
    "SecretKey": "YourDevSecretKeyMustBeAtLeast256BitsLongToWorkWithHmacSha256!!"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ]
  },
  "Authentication": {
    "AzureAd": {
      "Enabled": true,
      "TenantId": "46dc0c84-2276-4e56-8814-5c29d2c7fc66",
      "ClientId": "a701e77b-a479-4c28-831f-4f9d0e690cf5",
      "ClientSecret": "",
      "Audience": "api://a701e77b-a479-4c28-831f-4f9d0e690cf5",
      "Authority": "https://login.microsoftonline.com/46dc0c84-2276-4e56-8814-5c29d2c7fc66/v2.0",
      "ValidIssuer": "https://login.microsoftonline.com/46dc0c84-2276-4e56-8814-5c29d2c7fc66/v2.0",
      "EnableGuestInvitationOnLocalLogin": false,
      "InvitationRedirectUrl": "http://localhost:5173",
      "GraphBaseUrl": "https://graph.microsoft.com",
      "InvitationSendMail": true
    }
  },
  "Observability": {
    "UserActionLogging": {
      "Enabled": true,
      "PersistToMongo": true,
      "MongoCollectionName": "user_action_logs",
      "RetentionDays": 30,
      "DefaultQueryPageSize": 100,
      "MaxQueryPageSize": 300,
      "CorrelationHeaderName": "X-Correlation-Id",
      "ExcludedPathPrefixes": [
        "/health",
        "/openapi",
        "/scalar",
        "/hubs"
      ]
    }
  },
  "Integrations": {
    "UEBot": {
      "BaseUrl": "http://localhost:4010",
      "ExchangePath": "/integrations/forum/exchange",
      "SyncApiBaseUrl": "http://localhost:4010",
      "SharedSecret": "replace_with_local_dev_secret"
    }
  },
  "DetailedErrors": true
}