{
  "_instructions": "Copy this file to appsettings.Development.json and fill in your own credentials",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
  "Identity": {
    "PermissionCache": {
      "Provider": "InMemory",
      "ExpirationMinutes": 15,
      "RedisInstanceName": "UniHub:Identity"
    }
  },
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=unihub_db;Username=postgres;Password=YOUR_PASSWORD",
    "MongoDB": "mongodb://localhost:27017",
    "Redis": "localhost:6379"
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "unihub_db_dev",
    "ConnectionTimeoutSeconds": 30,
    "ServerSelectionTimeoutSeconds": 30,
    "MaxConnectionPoolSize": 100,
    "MinConnectionPoolSize": 0
  },
  "Jwt": {
    "SecretKey": "YourDevSecretKeyMustBeAtLeast256BitsLongToWorkWithHmacSha256!!"
  },
  "Observability": {
    "UserActionLogging": {
      "Enabled": true,
      "PersistToMongo": true,
      "MongoCollectionName": "user_action_logs",
      "RetentionDays": 30,
      "DefaultQueryPageSize": 100,
      "MaxQueryPageSize": 300,
      "CorrelationHeaderName": "X-Correlation-Id",
      "ExcludedPathPrefixes": [
        "/health",
        "/openapi",
        "/scalar",
        "/hubs"
      ]
    }
  },
  "DetailedErrors": true
}
