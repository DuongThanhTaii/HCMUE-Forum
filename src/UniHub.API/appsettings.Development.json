{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
      "_comment": "⚠️ DO NOT commit real credentials. Use User Secrets or env variables.",
    "DefaultConnection": "Host=127.0.0.1;Port=5433;Database=unihub;Username=unihub;Password=unihub_dev_2026",
    "PostgreSQL": "Host=127.0.0.1;Port=5433;Database=unihub;Username=unihub;Password=unihub_dev_2026",
    "MongoDB": "mongodb://localhost:27018",
    "Redis": "localhost:6380"
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27018",
    "DatabaseName": "unihub_db_dev",
    "ConnectionTimeoutSeconds": 30,
    "ServerSelectionTimeoutSeconds": 30,
    "MaxConnectionPoolSize": 100,
    "MinConnectionPoolSize": 0
  },
  "Jwt": {
    "SecretKey": "DevOnlySecretKeyForLocalTestingMustBeAtLeast256BitsLongToWork!!"
  },
  "Seeding": {
    "HighVolume": {
      "Enabled": false,
      "ForceReseed": false,
      "SkipMigrations": false,
      "TargetTotalRows": 500000,
      "BatchSize": 5000,
      "ExitAfterSeeding": false
    }
  },
  "Identity": {
    "PermissionCache": {
      "Provider": "InMemory",
      "ExpirationMinutes": 15,
      "RedisInstanceName": "UniHub:Identity"
    }
  },
  "Observability": {
    "UserActionLogging": {
      "Enabled": true,
      "PersistToMongo": true,
      "MongoCollectionName": "user_action_logs",
      "RetentionDays": 30,
      "DefaultQueryPageSize": 100,
      "MaxQueryPageSize": 300,
      "CorrelationHeaderName": "X-Correlation-Id",
      "ExcludedPathPrefixes": [
        "/health",
        "/openapi",
        "/scalar",
        "/hubs"
      ]
    }
  },
  "DetailedErrors": true
}
